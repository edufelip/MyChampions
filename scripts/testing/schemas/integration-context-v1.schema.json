{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mychampions.test/testing/integration-context-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "clientRoot": {
      "type": "string",
      "pattern": "^/"
    },
    "serverRoot": {
      "type": "string",
      "pattern": "^/"
    },
    "artifactRoot": {
      "type": "string",
      "pattern": "^/"
    },
    "appOrigin": {
      "type": "string",
      "format": "http-origin"
    },
    "apiOrigin": {
      "type": "string",
      "format": "http-origin"
    },
    "parentPid": {
      "type": "integer",
      "minimum": 2
    },
    "parentStarted": {
      "type": "string",
      "minLength": 1
    },
    "flagsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scenarioId": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "project": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "attemptId": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "fixtureScope": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          },
          "fixtureRef": {
            "type": "string",
            "pattern": "^/"
          },
          "fixtureHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scenarioHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requirementHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "controlToken": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "scenarioId",
          "project",
          "attemptId",
          "fixtureScope",
          "fixtureRef",
          "fixtureHash",
          "scenarioHash",
          "requirementHash",
          "controlToken"
        ]
      }
    },
    "control": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "string",
              "pattern": "^/"
            },
            "socket": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "required": ["root", "socket"]
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "clientRoot",
    "serverRoot",
    "artifactRoot",
    "appOrigin",
    "apiOrigin",
    "parentPid",
    "parentStarted",
    "flagsHash",
    "cases",
    "control"
  ]
}
