{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mychampions.test/testing/integration-harness-block-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[a-z-]+$"
    },
    "code": {
      "const": "worker-control"
    },
    "operation": {
      "enum": ["snapshot", "restart", "arm-save-fault", "clear-save-fault"]
    }
  },
  "required": ["schemaVersion", "runId", "attemptId", "code", "operation"]
}
