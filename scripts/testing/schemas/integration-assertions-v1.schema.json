{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mychampions.test/testing/integration-assertions-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
    "attemptId": { "type": "string", "pattern": "^[a-z-]+$" },
    "scenarioId": { "type": "string", "pattern": "^[a-z-]+$" },
    "project": { "type": "string", "pattern": "^[a-z-]+$" },
    "browserVersion": { "type": "string", "minLength": 1 },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z-]+$" },
          "requirementRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "outcome": { "enum": ["passed", "failed"] },
          "evidencePaths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            },
            "uniqueItems": true
          }
        },
        "required": ["id", "requirementRefs", "outcome", "evidencePaths"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "attemptId",
    "scenarioId",
    "project",
    "browserVersion",
    "assertions"
  ]
}
