# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.npm-cache/

# npm lockfiles are not used; Yarn's lockfile is committed for reproducible installs
package-lock.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
android/keystore.properties
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Local browser evidence (Playwright reports, traces, videos, and screenshots)
.artifacts/

# Raw Detox run output; curated evidence bundles under artifacts/ remain tracked
artifacts/ios.sim.debug.*/

# macOS
.DS_Store
*.pem

# local env files — never commit real values; use .env.example as template
.env
.env.local
.env.dev
.env.prod
.env*.local

# typescript
*.tsbuildinfo

app-example
