{
  "schemaVersion": 1,
  "maxChangedFiles": 500,
  "criticalSuites": ["maestro:student", "web:shell", "web:critical-paths"],
  "documentationPaths": ["docs/**", "*.md", ".github/ISSUE_TEMPLATE/**"],
  "runtimePaths": [
    "app/**",
    "assets/**",
    "components/**",
    "constants/**",
    "features/**",
    "hooks/**",
    "localization/**",
    "ios/**",
    "android/**",
    "e2e/**",
    "scripts/**",
    ".github/workflows/**",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.json",
    "yarn.lock"
  ],
  "fullFallbackPaths": [
    "config/test-impact.json",
    "scripts/ci/**",
    "tests/ci/**",
    ".github/workflows/**",
    "package.json",
    "yarn.lock",
    "app.config.ts",
    "app.json",
    "tsconfig.json",
    "eslint.config.js",
    "playwright*.config.ts",
    "e2e/web/support/test-profiles.ts",
    "e2e/web/support/create-web-test-config.ts",
    "scripts/testing/integration-preflight.ts",
    "scripts/testing/owned-session.ts",
    "scripts/testing/verify-session-acquisition.ts",
    "scripts/testing/owned-api-proxy.ts",
    "scripts/testing/verify-owned-api-proxy.ts",
    "scripts/testing/owned-expo.ts",
    "scripts/testing/owned-ios-simulator.ts",
    "scripts/testing/capture-native-testability.ts",
    "scripts/testing/native-runtime-preflight.ts",
    "scripts/testing/native-build-identity.ts",
    "scripts/testing/native-build-reuse.ts",
    "scripts/testing/generate-native-declaration.py",
    "scripts/testing/validate-native-inventory.mjs",
    "scripts/testing/vendor/**",
    "docs/qa/native-pilot/**",
    ".maestro/flows/**",
    "scripts/testing/owned-process-group.ts",
    "scripts/testing/verify-owned-expo.ts",
    "scripts/testing/integration-registry.ts",
    "scripts/testing/integration-context.ts",
    "scripts/testing/integration-results.ts",
    "scripts/testing/run-web-integration.ts",
    "scripts/testing/verify-web-integration.ts",
    "scripts/run-web-e2e-batch.mjs",
    "scripts/testing/schema-validation.ts",
    "scripts/testing/schemas/**",
    "scripts/testing/verify-domain-snapshot.ts",
    "scripts/testing/worker-control.ts",
    "scripts/testing/verify-worker-control.ts",
    "scripts/testing/verify-worker-control-receipt.ts"
  ],
  "sharedRules": [
    {
      "id": "navigation-shell",
      "paths": [
        "app/_layout.tsx",
        "app/index.tsx",
        "app/(tabs)/**",
        "features/auth/auth-route-guard.logic.ts",
        "features/auth/auth-session.tsx"
      ],
      "impact": "all"
    },
    {
      "id": "design-system-global",
      "paths": ["constants/design-system.ts", "constants/theme.ts"],
      "impact": "all"
    },
    {
      "id": "design-system-components",
      "paths": ["components/ds/**", "components/ui/**"],
      "impact": "reverse-importers"
    },
    {
      "id": "diagnostics-and-test-infrastructure",
      "paths": [
        "features/debug/**",
        "features/e2e/**",
        "features/id-source.ts",
        "features/id-source.test.ts"
      ],
      "impact": "reverse-importers"
    },
    {
      "id": "localization",
      "paths": ["localization/**", "docs/screens/v2/localized-copy-table-v2.md"],
      "impact": "all"
    },
    {
      "id": "native-ios",
      "paths": ["ios/**"],
      "impact": "all",
      "platforms": ["ios", "android"]
    },
    {
      "id": "native-android",
      "paths": ["android/**"],
      "impact": "all",
      "platforms": ["android"]
    },
    {
      "id": "maestro-shared-subflows",
      "paths": [".maestro/suite/common/**"],
      "impact": "all",
      "platforms": ["ios", "android"]
    },
    {
      "id": "maestro-ios-device-setup",
      "paths": [".maestro/setup/**"],
      "impact": "all",
      "platforms": ["ios"]
    }
  ],
  "features": {
    "auth": {
      "sourcePaths": ["features/auth/**", "app/auth/**"],
      "dependsOn": ["platform"],
      "unitTests": ["features/auth/**/*.test.ts"],
      "webSuites": [
        "web:auth",
        "web:server-auth",
        "web:integration-auth",
        "web:shell",
        "web:critical-paths",
        "web:manual-webview-recovery",
        "web:integration-denial"
      ],
      "nativeSuites": ["maestro:auth"],
      "owners": ["@edufelip"]
    },
    "connections": {
      "sourcePaths": [
        "features/connections/**",
        "app/student/professionals.tsx",
        "app/professional/pending.tsx"
      ],
      "dependsOn": ["auth", "platform"],
      "unitTests": ["features/connections/**/*.test.ts"],
      "webSuites": [
        "web:connections",
        "web:shell",
        "web:critical-paths",
        "web:integration-connections"
      ],
      "nativeSuites": ["maestro:connections"],
      "owners": ["@edufelip"]
    },
    "nutrition": {
      "sourcePaths": [
        "features/nutrition/**",
        "app/student/nutrition/**",
        "app/student/nutrition.tsx",
        "app/professional/nutrition/**",
        "app/professional/nutrition.tsx",
        "app/(tabs)/nutrition/**",
        "app/(tabs)/nutrition.tsx",
        "app/(tabs)/recipes.tsx",
        "app/shared/recipes/**"
      ],
      "dependsOn": ["auth", "connections", "offline", "platform"],
      "unitTests": ["features/nutrition/**/*.test.ts"],
      "webSuites": ["web:nutrition", "web:custom-meal-error", "web:shell"],
      "nativeSuites": ["maestro:nutrition"],
      "owners": ["@edufelip"]
    },
    "training": {
      "sourcePaths": [
        "features/training/**",
        "app/student/training/**",
        "app/student/training.tsx",
        "app/professional/training/**",
        "app/professional/training.tsx",
        "app/(tabs)/training.tsx"
      ],
      "dependsOn": ["auth", "connections", "offline", "plans", "platform"],
      "unitTests": ["features/training/**/*.test.ts"],
      "webSuites": [
        "web:training",
        "web:shell",
        "web:exercise-search",
        "web:assigned-plan-detail-heading",
        "web:integration-training",
        "web:integration-save-retry",
        "web:integration-denial"
      ],
      "nativeSuites": ["maestro:training"],
      "owners": ["@edufelip"]
    },
    "plans": {
      "sourcePaths": ["features/plans/**"],
      "dependsOn": ["auth", "connections", "offline", "platform"],
      "unitTests": ["features/plans/**/*.test.ts"],
      "webSuites": [
        "web:nutrition",
        "web:training",
        "web:exercise-search",
        "web:assigned-plan-detail-heading",
        "web:integration-training",
        "web:integration-save-retry",
        "web:integration-denial"
      ],
      "nativeSuites": ["maestro:plans"],
      "owners": ["@edufelip"]
    },
    "professional": {
      "sourcePaths": ["features/professional/**", "app/professional/**", "app/(tabs)/students.tsx"],
      "dependsOn": ["auth", "connections", "nutrition", "offline", "plans", "platform"],
      "unitTests": ["features/professional/**/*.test.ts"],
      "webSuites": [
        "web:professional",
        "web:professional-home",
        "web:professional-students-roster",
        "web:professional-roster-error",
        "web:professional-tabbar-labels",
        "web:shell"
      ],
      "nativeSuites": ["maestro:professional"],
      "owners": ["@edufelip"]
    },
    "subscription": {
      "sourcePaths": ["features/subscription/**", "app/professional/subscription.tsx"],
      "dependsOn": ["auth", "platform", "professional"],
      "unitTests": ["features/subscription/**/*.test.ts"],
      "webSuites": ["web:subscription", "web:critical-paths", "web:subscription-lock"],
      "nativeSuites": ["maestro:subscription", "maestro:revenuecat-live"],
      "owners": ["@edufelip"]
    },
    "support": {
      "sourcePaths": ["features/support/**", "components/ds/patterns/SupportModal.tsx"],
      "dependsOn": ["auth", "offline", "platform"],
      "unitTests": ["features/support/**/*.test.ts"],
      "webSuites": ["web:shell", "web:server-support"],
      "nativeSuites": ["maestro:support"],
      "owners": ["@edufelip"]
    },
    "student": {
      "sourcePaths": ["features/student/**", "app/student/home.tsx", "app/(tabs)/index.tsx"],
      "dependsOn": [
        "auth",
        "connections",
        "nutrition",
        "offline",
        "plans",
        "subscription",
        "training"
      ],
      "unitTests": ["features/student/**/*.test.ts"],
      "webSuites": ["web:student", "web:shell"],
      "nativeSuites": ["maestro:student"],
      "owners": ["@edufelip"]
    },
    "analytics": {
      "sourcePaths": ["features/analytics/**"],
      "dependsOn": ["auth", "platform"],
      "unitTests": ["features/analytics/**/*.test.ts"],
      "webSuites": ["web:shell"],
      "nativeSuites": [],
      "owners": ["@edufelip"]
    },
    "offline": {
      "sourcePaths": ["features/offline/**"],
      "dependsOn": ["platform"],
      "unitTests": ["features/offline/**/*.test.ts"],
      "webSuites": ["web:shell"],
      "nativeSuites": ["maestro:offline"],
      "owners": ["@edufelip"]
    },
    "platform": {
      "sourcePaths": [
        "features/platform/**",
        "app/shared/webview.tsx",
        "app/shared/webview.web.tsx",
        "app/+html.tsx"
      ],
      "dependsOn": [],
      "unitTests": ["features/platform/**/*.test.ts"],
      "webSuites": ["web:platform"],
      "nativeSuites": ["maestro:platform"],
      "owners": ["@edufelip"]
    }
  },
  "allowedDependencyCycles": [
    ["nutrition", "plans"],
    ["professional", "subscription"]
  ],
