    "web:auth": {
      "runner": "playwright",
      "projects": ["chromium"],
      "specs": ["e2e/web/platform-fallbacks.spec.ts", "e2e/web/responsive-shell.spec.ts"],
      "grep": "@feature:auth|@critical",
      "tier": "feature",
      "ci": true
    },
    "web:server-auth": {
      "runner": "playwright-server",
      "projects": ["chromium", "firefox", "webkit"],
      "specs": [
        "e2e/web-server/auth-session.spec.ts",
        "e2e/web-server/create-account-enumeration.spec.ts"
      ],
      "grep": "@feature:auth|@critical",
      "tier": "critical",
      "ci": true
    },
    "web:connections": {
      "runner": "playwright",
      "projects": ["chromium"],
      "specs": ["e2e/web/platform-fallbacks.spec.ts", "e2e/web/responsive-shell.spec.ts"],
      "grep": "@feature:connections",
      "tier": "feature",
      "ci": true
    },
    "web:nutrition": {
      "runner": "playwright",
      "projects": ["chromium"],
      "specs": [
        "e2e/web/responsive-shell.spec.ts",
        "e2e/web/custom-meal-library-error-recovery.spec.ts"
      ],
      "grep": "@feature:nutrition",
      "tier": "feature",
      "ci": true
    },
    "web:training": {
      "runner": "playwright",
      "projects": ["chromium"],
