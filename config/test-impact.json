      "projects": ["mobile-professional", "mobile-professional-pt", "mobile-professional-es"],
      "specs": ["e2e/web/professional-home-responsive.spec.ts"],
      "grep": "@feature:professional",
      "tier": "feature",
      "ci": true
    },
    "web:specialty-removal-assist": {
