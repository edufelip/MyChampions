        "e2e/auth-terms.e2e.test.js",
        "e2e/account-password-reset.e2e.test.js",
        "e2e/account-deletion.e2e.test.js",
        "e2e/account-settings.e2e.test.js",
        "e2e/language-select.e2e.test.js"
