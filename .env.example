# ─────────────────────────────────────────────────────────────────────────────
# my-champions environment template
# Copy this file to .env and fill in all values.
# .env is gitignored and must never be committed.
#
# For CI: populate the ENV_FILE GitHub secret with all variables below.
# ─────────────────────────────────────────────────────────────────────────────

# Build variant — set to 'prod' for production builds; omit or set to 'dev' otherwise.
APP_VARIANT=dev

# ── Terms Acceptance Gate ────────────────────────────────────────────────────
# Required terms version and URL displayed in /auth/accept-terms.
# This is a client-side config fallback while server profile terms fields hydrate.
EXPO_PUBLIC_TERMS_REQUIRED_VERSION=v1
EXPO_PUBLIC_TERMS_URL=https://portfolio.eduwaldo.com/projects/my-champions/terms_of_use
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://portfolio.eduwaldo.com/projects/my-champions/privacy_policy

# ── Debug Logging ──────────────────────────────────────────────────────────────
# Global debug switch for source/network logs used by local server integrations.
# - true  => force enable debug logs
# - false => force disable debug logs
# - unset => auto-enable in __DEV or APP_VARIANT=dev
EXPO_PUBLIC_DEBUG_LOGS=

# ── MyChampions Server ────────────────────────────────────────────────────────
# Local-first backend for migrated app logic.
# iOS Simulator can use localhost. Physical devices need this Mac's LAN IP.
# Production release ENV_FILE values must instead use https://api.mychampions.eduwaldo.com.
EXPO_PUBLIC_MYCHAMPIONS_SERVER_URL=http://localhost:3400

# ── Native Google OAuth ──────────────────────────────────────────────────────
# Public OAuth client IDs for native Google sign-in. These are client IDs, not
# secrets. Leave blank to fall back to deterministic local dev social sessions.
# Native sign-in requires the web client ID; iOS also uses its iOS client ID.
# Android's client ID records the package/SHA registration and is release-gated.
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=
# The client IDs are public OAuth client IDs; never put client secrets in mobile env.

# ── Detox E2E Auth Harness (dev only) ─────────────────────────────────────────
# Set to true only when running the explicit Detox E2E auth-session harness.
# The app ignores this unless __DEV__ is true and APP_VARIANT=dev.
EXPO_PUBLIC_E2E_AUTH_SESSION=
# Optional: set to true to let the sign-in screen accept the deterministic
# dev-only email/password fixture.
EXPO_PUBLIC_E2E_EMAIL_PASSWORD_SIGN_IN=
# Optional: set to true to let the create-account screen accept the deterministic
# dev-only email/password fixture.
EXPO_PUBLIC_E2E_CREATE_ACCOUNT=
# Optional: set to true to let Google/Apple auth entry buttons complete with
# deterministic dev-only social users without launching provider UI.
EXPO_PUBLIC_E2E_SOCIAL_AUTH=
# Optional: set to an older terms version such as v0 to force the terms gate
# while EXPO_PUBLIC_E2E_AUTH_SESSION=true.
EXPO_PUBLIC_E2E_ACCEPTED_TERMS_VERSION=
# Optional deterministic source fixtures used only with the dev E2E auth harness.
EXPO_PUBLIC_E2E_PRO_ROSTER_FIXTURE=
EXPO_PUBLIC_E2E_PRO_PLANS_FIXTURE=
EXPO_PUBLIC_E2E_STUDENT_NUTRITION_FIXTURE=
EXPO_PUBLIC_E2E_STUDENT_TRAINING_FIXTURE=
EXPO_PUBLIC_E2E_INVITE_SUBMIT_FIXTURE=
EXPO_PUBLIC_E2E_QR_INVITE_PAYLOAD=
EXPO_PUBLIC_E2E_CUSTOM_MEALS_FIXTURE=
EXPO_PUBLIC_E2E_IMAGE_UPLOAD_FIXTURE=
EXPO_PUBLIC_E2E_FOOD_SEARCH_FIXTURE=
EXPO_PUBLIC_E2E_EXERCISE_SEARCH_FIXTURE=
EXPO_PUBLIC_E2E_PRO_ENTITLEMENT_STATUS=
EXPO_PUBLIC_E2E_PRO_ACTIVE_STUDENT_COUNT=
EXPO_PUBLIC_E2E_AI_ENTITLEMENT_STATUS=
EXPO_PUBLIC_E2E_MEAL_ANALYSIS_FIXTURE=
# Optional deterministic network status override for offline-mode E2E stories.
# Accepted values: online, offline, unknown. Ignored outside __DEV__ + APP_VARIANT=dev.
EXPO_PUBLIC_E2E_NETWORK_STATUS=

# ── RevenueCat ────────────────────────────────────────────────────────────────
# Public SDK keys for the RevenueCat project (safe to ship in binary — not secret).
# iOS must use appl_* and Android must use goog_*.
# Variant-specific keys are preferred:
# - APP_VARIANT=dev  -> *_DEV keys (bundle/package .dev)
# - APP_VARIANT=prod -> *_PROD keys (production bundle/package)
# Production CI requires the platform-specific *_PROD key and validates its prefix.
# Refs: D-130, BL-107, FR-126–129, BR-218–221, SC-204, SC-206, SC-212
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS_DEV=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID_DEV=
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS_PROD=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID_PROD=

# ── Exercise Catalog Integration ──────────────────────────────────────────────
# SC-208 exercise search uses EXPO_PUBLIC_MYCHAMPIONS_SERVER_URL plus the local
# MyChampions bearer token. Mobile must never send upstream YMove API keys.
