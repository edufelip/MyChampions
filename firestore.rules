rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isConnectionParticipant() {
      return signedIn() && (
        resource.data.studentAuthUid == request.auth.uid ||
        resource.data.professionalAuthUid == request.auth.uid
      );
    }

    function roleLockUnchanged() {
      return !("lockedRole" in resource.data) ||
        resource.data.lockedRole == null ||
        request.resource.data.lockedRole == resource.data.lockedRole;
    }

    function connectionIdentityUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.studentAuthUid == resource.data.studentAuthUid &&
        request.resource.data.professionalAuthUid == resource.data.professionalAuthUid &&
        request.resource.data.specialty == resource.data.specialty &&
        request.resource.data.sourceInviteCodeId == resource.data.sourceInviteCodeId &&
        request.resource.data.get('sourceInviteCodeValue', null) == resource.data.get('sourceInviteCodeValue', null) &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function validConnectionStatusTransition(connectionId) {
      return (
        resource.data.status == 'pending_confirmation' &&
        request.auth.uid == resource.data.professionalAuthUid &&
        request.resource.data.status == 'active' &&
        request.resource.data.canceledReason == null &&
        request.resource.data.endedAt == null &&
        hasActiveProfessionalSpecialty(resource.data.professionalAuthUid, resource.data.specialty) &&
        validPendingInviteStateReleasedAfter(connectionId) &&
        validConnectionTrackingAccessAfter(connectionId, 'active') &&
        validConnectionActiveSpecialtyAfter(connectionId, 'active')
      ) || (
        resource.data.status == 'pending_confirmation' &&
        request.auth.uid == resource.data.professionalAuthUid &&
        request.resource.data.status == 'ended' &&
        request.resource.data.canceledReason == 'code_rotated' &&
        request.resource.data.endedAt is string &&
        validPendingInviteStateReleasedAfter(connectionId)
      ) || (
        (resource.data.status == 'pending_confirmation' || resource.data.status == 'active') &&
        request.resource.data.status == 'ended' &&
        request.resource.data.canceledReason == null &&
        request.resource.data.endedAt is string &&
        (resource.data.status != 'pending_confirmation' || validPendingInviteStateReleasedAfter(connectionId)) &&
        validConnectionTrackingAccessAfter(connectionId, 'ended') &&
        validConnectionActiveSpecialtyAfter(connectionId, 'ended')
      );
    }

    function pendingInviteGuardPath() {
      return /databases/$(database)/documents/connectionInviteGuards/$(resource.data.professionalAuthUid + '_' + resource.data.studentAuthUid + '_' + resource.data.specialty);
    }

    function pendingStudentPath() {
      return /databases/$(database)/documents/professionals/$(resource.data.professionalAuthUid)/pendingStudents/$(resource.data.studentAuthUid);
    }

    function pendingStudentSlotPath(slotId) {
      return /databases/$(database)/documents/professionals/$(resource.data.professionalAuthUid)/pendingStudentSlots/$(slotId);
    }

    function validPendingInviteStateReleasedAfter(connectionId) {
      return (!exists(pendingInviteGuardPath()) || !existsAfter(pendingInviteGuardPath())) &&
        validPendingStudentStateReleasedAfter(connectionId);
    }

    function validPendingStudentStateReleasedAfter(connectionId) {
      return !exists(pendingStudentPath()) || (
        (
          resource.data.specialty == 'nutritionist' &&
          get(pendingStudentPath()).data.get('nutritionistConnectionId', null) == connectionId &&
          getAfter(pendingStudentPath()).data.get('nutritionistConnectionId', null) == null &&
          (
            get(pendingStudentPath()).data.get('fitnessCoachConnectionId', null) is string ||
            getAfter(pendingStudentSlotPath(get(pendingStudentPath()).data.slotId)).data.studentAuthUid == null
          )
        ) || (
          resource.data.specialty == 'fitness_coach' &&
          get(pendingStudentPath()).data.get('fitnessCoachConnectionId', null) == connectionId &&
          getAfter(pendingStudentPath()).data.get('fitnessCoachConnectionId', null) == null &&
          (
            get(pendingStudentPath()).data.get('nutritionistConnectionId', null) is string ||
            getAfter(pendingStudentSlotPath(get(pendingStudentPath()).data.slotId)).data.studentAuthUid == null
          )
        ) || (
          resource.data.specialty == 'nutritionist' &&
          get(pendingStudentPath()).data.get('nutritionistConnectionId', null) != connectionId
        ) || (
          resource.data.specialty == 'fitness_coach' &&
          get(pendingStudentPath()).data.get('fitnessCoachConnectionId', null) != connectionId
        )
      );
    }

    function validReleasedPendingConnection(connectionId, professionalUid, studentUid, specialty) {
      return signedIn() &&
        exists(/databases/$(database)/documents/connections/$(connectionId)) &&
        get(/databases/$(database)/documents/connections/$(connectionId)).data.status == 'pending_confirmation' &&
        get(/databases/$(database)/documents/connections/$(connectionId)).data.professionalAuthUid == professionalUid &&
        get(/databases/$(database)/documents/connections/$(connectionId)).data.studentAuthUid == studentUid &&
        get(/databases/$(database)/documents/connections/$(connectionId)).data.specialty == specialty &&
        getAfter(/databases/$(database)/documents/connections/$(connectionId)).data.professionalAuthUid == professionalUid &&
        getAfter(/databases/$(database)/documents/connections/$(connectionId)).data.studentAuthUid == studentUid &&
        getAfter(/databases/$(database)/documents/connections/$(connectionId)).data.specialty == specialty &&
        (getAfter(/databases/$(database)/documents/connections/$(connectionId)).data.status == 'active' ||
          getAfter(/databases/$(database)/documents/connections/$(connectionId)).data.status == 'ended');
    }

    function validPendingStudentRelease(professionalUid, studentUid) {
      return signedIn() &&
        (request.auth.uid == professionalUid || request.auth.uid == studentUid) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.professionalAuthUid == professionalUid &&
        request.resource.data.studentAuthUid == studentUid &&
        request.resource.data.slotId == resource.data.slotId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt is string &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nutritionistConnectionId', 'updatedAt']) &&
            resource.data.nutritionistConnectionId is string &&
            request.resource.data.get('nutritionistConnectionId', null) == null &&
            request.resource.data.get('fitnessCoachConnectionId', null) == resource.data.get('fitnessCoachConnectionId', null) &&
            validReleasedPendingConnection(resource.data.nutritionistConnectionId, professionalUid, studentUid, 'nutritionist')
          ) || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fitnessCoachConnectionId', 'updatedAt']) &&
            resource.data.fitnessCoachConnectionId is string &&
            request.resource.data.get('fitnessCoachConnectionId', null) == null &&
            request.resource.data.get('nutritionistConnectionId', null) == resource.data.get('nutritionistConnectionId', null) &&
            validReleasedPendingConnection(resource.data.fitnessCoachConnectionId, professionalUid, studentUid, 'fitness_coach')
          )
        );
    }

    function validPendingStudentSlotRelease(professionalUid) {
      return signedIn() &&
        (request.auth.uid == professionalUid || request.auth.uid == resource.data.studentAuthUid) &&
        resource.data.professionalAuthUid == professionalUid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.professionalAuthUid == professionalUid &&
        request.resource.data.studentAuthUid == null &&
        request.resource.data.updatedAt is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentAuthUid', 'updatedAt']) &&
        getAfter(/databases/$(database)/documents/professionals/$(professionalUid)/pendingStudents/$(resource.data.studentAuthUid)).data.get('nutritionistConnectionId', null) == null &&
        getAfter(/databases/$(database)/documents/professionals/$(professionalUid)/pendingStudents/$(resource.data.studentAuthUid)).data.get('fitnessCoachConnectionId', null) == null;
    }

    function validPendingInviteGuardRelease() {
      return signedIn() &&
        (request.auth.uid == resource.data.professionalAuthUid || request.auth.uid == resource.data.studentAuthUid) &&
        validReleasedPendingConnection(
          resource.data.connectionId,
          resource.data.professionalAuthUid,
          resource.data.studentAuthUid,
          resource.data.specialty
        );
    }

    function validConnectionTrackingAccessAfter(connectionId, status) {
      return (
        resource.data.specialty == 'nutritionist' &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/nutritionists/$(resource.data.professionalAuthUid)).data.studentAuthUid == resource.data.studentAuthUid &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/nutritionists/$(resource.data.professionalAuthUid)).data.professionalAuthUid == resource.data.professionalAuthUid &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/nutritionists/$(resource.data.professionalAuthUid)).data.specialty == resource.data.specialty &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/nutritionists/$(resource.data.professionalAuthUid)).data.connectionId == connectionId &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/nutritionists/$(resource.data.professionalAuthUid)).data.status == status
      ) || (
        resource.data.specialty == 'fitness_coach' &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/fitnessCoaches/$(resource.data.professionalAuthUid)).data.studentAuthUid == resource.data.studentAuthUid &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/fitnessCoaches/$(resource.data.professionalAuthUid)).data.professionalAuthUid == resource.data.professionalAuthUid &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/fitnessCoaches/$(resource.data.professionalAuthUid)).data.specialty == resource.data.specialty &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/fitnessCoaches/$(resource.data.professionalAuthUid)).data.connectionId == connectionId &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/fitnessCoaches/$(resource.data.professionalAuthUid)).data.status == status
      );
    }

    function validConnectionActiveSpecialtyAfter(connectionId, status) {
      return (
        status == 'ended' &&
        exists(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/activeSpecialties/$(resource.data.specialty)) &&
        get(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/activeSpecialties/$(resource.data.specialty)).data.connectionId != connectionId
      ) || (
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/activeSpecialties/$(resource.data.specialty)).data.studentAuthUid == resource.data.studentAuthUid &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/activeSpecialties/$(resource.data.specialty)).data.professionalAuthUid == resource.data.professionalAuthUid &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/activeSpecialties/$(resource.data.specialty)).data.specialty == resource.data.specialty &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/activeSpecialties/$(resource.data.specialty)).data.connectionId == connectionId &&
        getAfter(/databases/$(database)/documents/trackingAccess/$(resource.data.studentAuthUid)/activeSpecialties/$(resource.data.specialty)).data.status == status
      );
    }

    function validConnectionCreate(connectionId) {
      return signedIn() &&
        request.resource.data.id == connectionId &&
        request.resource.data.studentAuthUid == request.auth.uid &&
        request.resource.data.professionalAuthUid is string &&
        request.resource.data.professionalAuthUid != request.auth.uid &&
        (request.resource.data.specialty == 'nutritionist' || request.resource.data.specialty == 'fitness_coach') &&
        hasActiveProfessionalSpecialty(request.resource.data.professionalAuthUid, request.resource.data.specialty) &&
        request.resource.data.status == 'pending_confirmation' &&
        request.resource.data.canceledReason == null &&
        request.resource.data.endedAt == null &&
        request.resource.data.sourceInviteCodeId == request.resource.data.specialty &&
        request.resource.data.sourceInviteCodeValue is string &&
        exists(/databases/$(database)/documents/inviteCodeLookups/$(request.resource.data.sourceInviteCodeValue)) &&
        exists(/databases/$(database)/documents/professionals/$(request.resource.data.professionalAuthUid)/inviteCodes/$(request.resource.data.specialty)) &&
        get(/databases/$(database)/documents/inviteCodeLookups/$(request.resource.data.sourceInviteCodeValue)).data.scope == 'invite_code_lookup' &&
        get(/databases/$(database)/documents/inviteCodeLookups/$(request.resource.data.sourceInviteCodeValue)).data.codeValue == request.resource.data.sourceInviteCodeValue &&
        get(/databases/$(database)/documents/inviteCodeLookups/$(request.resource.data.sourceInviteCodeValue)).data.professionalAuthUid == request.resource.data.professionalAuthUid &&
        get(/databases/$(database)/documents/inviteCodeLookups/$(request.resource.data.sourceInviteCodeValue)).data.specialty == request.resource.data.specialty &&
        get(/databases/$(database)/documents/inviteCodeLookups/$(request.resource.data.sourceInviteCodeValue)).data.inviteCodeId == request.resource.data.sourceInviteCodeId &&
        get(/databases/$(database)/documents/inviteCodeLookups/$(request.resource.data.sourceInviteCodeValue)).data.status == 'active' &&
        get(/databases/$(database)/documents/professionals/$(request.resource.data.professionalAuthUid)/inviteCodes/$(request.resource.data.specialty)).data.scope == 'professional_specialty' &&
        get(/databases/$(database)/documents/professionals/$(request.resource.data.professionalAuthUid)/inviteCodes/$(request.resource.data.specialty)).data.professionalAuthUid == request.resource.data.professionalAuthUid &&
        get(/databases/$(database)/documents/professionals/$(request.resource.data.professionalAuthUid)/inviteCodes/$(request.resource.data.specialty)).data.specialty == request.resource.data.specialty &&
        get(/databases/$(database)/documents/professionals/$(request.resource.data.professionalAuthUid)/inviteCodes/$(request.resource.data.specialty)).data.codeValue == request.resource.data.sourceInviteCodeValue &&
        get(/databases/$(database)/documents/professionals/$(request.resource.data.professionalAuthUid)/inviteCodes/$(request.resource.data.specialty)).data.status == 'active';
    }

    function ownsPlan(planId) {
      return (
        exists(/databases/$(database)/documents/nutritionPlans/$(planId)) &&
        get(/databases/$(database)/documents/nutritionPlans/$(planId)).data.ownerProfessionalUid == request.auth.uid
      ) || (
        exists(/databases/$(database)/documents/trainingPlans/$(planId)) &&
        get(/databases/$(database)/documents/trainingPlans/$(planId)).data.ownerProfessionalUid == request.auth.uid
      );
    }

    function hasActiveNutritionistTrackingAccess(ownerUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/trackingAccess/$(ownerUid)/nutritionists/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/nutritionists/$(request.auth.uid)).data.connectionId)) &&
        get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/nutritionists/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/nutritionists/$(request.auth.uid)).data.connectionId)).data.status == 'active' &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/nutritionists/$(request.auth.uid)).data.connectionId)).data.studentAuthUid == ownerUid &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/nutritionists/$(request.auth.uid)).data.connectionId)).data.professionalAuthUid == request.auth.uid &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/nutritionists/$(request.auth.uid)).data.connectionId)).data.specialty == 'nutritionist';
    }

    function hasActiveFitnessCoachTrackingAccess(ownerUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/trackingAccess/$(ownerUid)/fitnessCoaches/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/fitnessCoaches/$(request.auth.uid)).data.connectionId)) &&
        get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/fitnessCoaches/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/fitnessCoaches/$(request.auth.uid)).data.connectionId)).data.status == 'active' &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/fitnessCoaches/$(request.auth.uid)).data.connectionId)).data.studentAuthUid == ownerUid &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/fitnessCoaches/$(request.auth.uid)).data.connectionId)).data.professionalAuthUid == request.auth.uid &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(ownerUid)/fitnessCoaches/$(request.auth.uid)).data.connectionId)).data.specialty == 'fitness_coach';
    }

    function hasActiveNutritionistConnectionForStudentAndProfessional(studentUid, professionalUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/trackingAccess/$(studentUid)/nutritionists/$(professionalUid)) &&
        exists(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(studentUid)/nutritionists/$(professionalUid)).data.connectionId)) &&
        get(/databases/$(database)/documents/trackingAccess/$(studentUid)/nutritionists/$(professionalUid)).data.status == 'active' &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(studentUid)/nutritionists/$(professionalUid)).data.connectionId)).data.status == 'active' &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(studentUid)/nutritionists/$(professionalUid)).data.connectionId)).data.studentAuthUid == studentUid &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(studentUid)/nutritionists/$(professionalUid)).data.connectionId)).data.professionalAuthUid == professionalUid &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(studentUid)/nutritionists/$(professionalUid)).data.connectionId)).data.specialty == 'nutritionist';
    }

    function hasActiveFitnessCoachConnectionForStudentAndProfessional(studentUid, professionalUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/trackingAccess/$(studentUid)/fitnessCoaches/$(professionalUid)) &&
        exists(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(studentUid)/fitnessCoaches/$(professionalUid)).data.connectionId)) &&
        get(/databases/$(database)/documents/trackingAccess/$(studentUid)/fitnessCoaches/$(professionalUid)).data.status == 'active' &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(studentUid)/fitnessCoaches/$(professionalUid)).data.connectionId)).data.status == 'active' &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(studentUid)/fitnessCoaches/$(professionalUid)).data.connectionId)).data.studentAuthUid == studentUid &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(studentUid)/fitnessCoaches/$(professionalUid)).data.connectionId)).data.professionalAuthUid == professionalUid &&
        get(/databases/$(database)/documents/connections/$(get(/databases/$(database)/documents/trackingAccess/$(studentUid)/fitnessCoaches/$(professionalUid)).data.connectionId)).data.specialty == 'fitness_coach';
    }

    function hasProfessionalRole(uid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/userProfiles/$(uid)) &&
        get(/databases/$(database)/documents/userProfiles/$(uid)).data.lockedRole == 'professional';
    }

    function hasActiveProfessionalSpecialty(uid, specialty) {
      return hasProfessionalRole(uid) &&
        exists(/databases/$(database)/documents/specialties/$(uid + '_' + specialty)) &&
        get(/databases/$(database)/documents/specialties/$(uid + '_' + specialty)).data.professionalAuthUid == uid &&
        get(/databases/$(database)/documents/specialties/$(uid + '_' + specialty)).data.specialty == specialty &&
        get(/databases/$(database)/documents/specialties/$(uid + '_' + specialty)).data.isActive == true;
    }

    function hasActiveNutritionistSpecialtyForStudent(studentUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/trackingAccess/$(studentUid)/activeSpecialties/nutritionist) &&
        get(/databases/$(database)/documents/trackingAccess/$(studentUid)/activeSpecialties/nutritionist).data.status == 'active';
    }

    function hasActiveFitnessCoachSpecialtyForStudent(studentUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/trackingAccess/$(studentUid)/activeSpecialties/fitness_coach) &&
        get(/databases/$(database)/documents/trackingAccess/$(studentUid)/activeSpecialties/fitness_coach).data.status == 'active';
    }

    function validTrackingAccessWrite(studentUid, professionalUid, specialty) {
      return signedIn() &&
        (
          (request.resource.data.status == 'active' && request.auth.uid == professionalUid) ||
          (request.resource.data.status == 'ended' && (request.auth.uid == studentUid || request.auth.uid == professionalUid))
        ) &&
        request.resource.data.studentAuthUid == studentUid &&
        request.resource.data.professionalAuthUid == professionalUid &&
        request.resource.data.specialty == specialty &&
        request.resource.data.connectionId is string &&
        (request.resource.data.status == 'active' || request.resource.data.status == 'ended') &&
        exists(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)) &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.studentAuthUid == studentUid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.professionalAuthUid == professionalUid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.specialty == specialty &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.status == request.resource.data.status;
    }

    function validActiveSpecialtyWriteFieldsAndConnection(studentUid, specialtyId) {
      return signedIn() &&
        (
          (request.resource.data.status == 'active' && request.auth.uid == request.resource.data.professionalAuthUid) ||
          (request.resource.data.status == 'ended' && (request.auth.uid == studentUid || request.auth.uid == request.resource.data.professionalAuthUid))
        ) &&
        request.resource.data.studentAuthUid == studentUid &&
        request.resource.data.professionalAuthUid is string &&
        request.resource.data.specialty == specialtyId &&
        request.resource.data.connectionId is string &&
        (request.resource.data.status == 'active' || request.resource.data.status == 'ended') &&
        exists(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)) &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.studentAuthUid == studentUid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.professionalAuthUid == request.resource.data.professionalAuthUid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.specialty == specialtyId &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.status == request.resource.data.status;
    }

    function validActiveSpecialtyCreate(studentUid, specialtyId) {
      return validActiveSpecialtyWriteFieldsAndConnection(studentUid, specialtyId);
    }

    function validActiveSpecialtyUpdate(studentUid, specialtyId) {
      return validActiveSpecialtyWriteFieldsAndConnection(studentUid, specialtyId) && (
        (
          request.resource.data.status == 'active' &&
          (resource.data.status != 'active' || resource.data.connectionId == request.resource.data.connectionId)
        ) || (
          request.resource.data.status == 'ended' &&
          resource.data.connectionId == request.resource.data.connectionId
        )
      );
    }

    function planLifecycleStateOnlyChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isArchived', 'updatedAt', 'lifecycleConnectionId']) &&
        request.resource.data.updatedAt is string &&
        request.resource.data.lifecycleConnectionId is string;
    }

    function planLifecycleMarkerUnchanged() {
      return request.resource.data.get('lifecycleConnectionId', null) == resource.data.get('lifecycleConnectionId', null);
    }

    function planArchiveMetadataUnchanged() {
      return request.resource.data.isArchived == resource.data.isArchived &&
        planLifecycleMarkerUnchanged();
    }

    function hasActivatedNutritionistConnectionForPlan(studentUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)) &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.status == 'pending_confirmation' &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid == studentUid &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid == request.auth.uid &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.specialty == 'nutritionist' &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.status == 'active' &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid == studentUid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.specialty == 'nutritionist';
    }

    function hasActivatedFitnessCoachConnectionForPlan(studentUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)) &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.status == 'pending_confirmation' &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid == studentUid &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid == request.auth.uid &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.specialty == 'fitness_coach' &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.status == 'active' &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid == studentUid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.specialty == 'fitness_coach';
    }

    function hasEndedNutritionistConnectionForPlan(studentUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)) &&
        (request.auth.uid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid ||
          request.auth.uid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid) &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.status == 'active' &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid == studentUid &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.specialty == 'nutritionist' &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.status == 'ended' &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid == studentUid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.specialty == 'nutritionist';
    }

    function hasExistingEndedNutritionistConnectionForPlan(studentUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)) &&
        (request.auth.uid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid ||
          request.auth.uid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid) &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.status == 'ended' &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid == studentUid &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.specialty == 'nutritionist';
    }

    function hasEndedFitnessCoachConnectionForPlan(studentUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)) &&
        (request.auth.uid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid ||
          request.auth.uid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid) &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.status == 'active' &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid == studentUid &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.specialty == 'fitness_coach' &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.status == 'ended' &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid == studentUid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid &&
        getAfter(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.specialty == 'fitness_coach';
    }

    function hasExistingEndedFitnessCoachConnectionForPlan(studentUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)) &&
        (request.auth.uid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid ||
          request.auth.uid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid) &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.status == 'ended' &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.studentAuthUid == studentUid &&
        get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.specialty == 'fitness_coach';
    }

    match /userProfiles/{userId} {
      allow read, delete: if isUid(userId);
      allow create: if isUid(userId) && request.resource.data.authUid == request.auth.uid;
      allow update: if isUid(userId) && roleLockUnchanged();
    }

    match /inviteCodes/{professionalUid} {
      allow read, create, update, delete: if false;
    }

    match /professionals/{professionalUid}/inviteCodes/{specialty} {
      allow read: if signedIn() && (professionalUid == request.auth.uid || resource.data.status == 'active');
      allow create, update: if isUid(professionalUid) &&
        hasActiveProfessionalSpecialty(request.auth.uid, specialty) &&
        (specialty == 'nutritionist' || specialty == 'fitness_coach') &&
        request.resource.data.scope == 'professional_specialty' &&
        request.resource.data.professionalAuthUid == request.auth.uid &&
        request.resource.data.specialty == specialty;
      allow delete: if isUid(professionalUid) && hasActiveProfessionalSpecialty(request.auth.uid, resource.data.specialty);
    }

    match /professionals/{professionalUid}/pendingStudents/{studentUid} {
      allow read: if signedIn() && (request.auth.uid == professionalUid || request.auth.uid == studentUid);
      allow create, delete: if false;
      allow update: if validPendingStudentRelease(professionalUid, studentUid);
    }

    match /professionals/{professionalUid}/pendingStudentSlots/{slotId} {
      allow read: if signedIn() && request.auth.uid == professionalUid;
      allow create, delete: if false;
      allow update: if validPendingStudentSlotRelease(professionalUid);
    }

    match /connectionInviteGuards/{guardId} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.professionalAuthUid || request.auth.uid == resource.data.studentAuthUid);
      allow create, update: if false;
      allow delete: if validPendingInviteGuardRelease();
    }

    match /{path=**}/inviteCodes/{specialty} {
      allow list: if false;
    }

    match /inviteCodeLookups/{codeValue} {
      allow get: if signedIn() &&
        resource.data.scope == 'invite_code_lookup' &&
        resource.data.codeValue == codeValue &&
        resource.data.status == 'active' &&
        resource.data.inviteCodeId == resource.data.specialty &&
        (resource.data.specialty == 'nutritionist' || resource.data.specialty == 'fitness_coach');
      allow create: if signedIn() &&
        hasActiveProfessionalSpecialty(request.auth.uid, request.resource.data.specialty) &&
        request.resource.data.scope == 'invite_code_lookup' &&
        request.resource.data.codeValue == codeValue &&
        request.resource.data.professionalAuthUid == request.auth.uid &&
        request.resource.data.inviteCodeId == request.resource.data.specialty &&
        (request.resource.data.specialty == 'nutritionist' || request.resource.data.specialty == 'fitness_coach');
      allow update: if signedIn() &&
        resource.data.professionalAuthUid == request.auth.uid &&
        hasActiveProfessionalSpecialty(request.auth.uid, request.resource.data.specialty) &&
        request.resource.data.scope == 'invite_code_lookup' &&
        request.resource.data.codeValue == codeValue &&
        request.resource.data.professionalAuthUid == request.auth.uid &&
        request.resource.data.inviteCodeId == request.resource.data.specialty &&
        (request.resource.data.specialty == 'nutritionist' || request.resource.data.specialty == 'fitness_coach');
      allow delete: if signedIn() &&
        resource.data.professionalAuthUid == request.auth.uid &&
        hasActiveProfessionalSpecialty(request.auth.uid, resource.data.specialty);
    }

    match /connections/{connectionId} {
      allow read: if isConnectionParticipant();
      allow create: if false;
      allow update: if isConnectionParticipant() &&
        connectionIdentityUnchanged() &&
        validConnectionStatusTransition(connectionId);
      allow delete: if false;
    }

    match /specialties/{specialtyId} {
      allow read: if signedIn() && resource.data.professionalAuthUid == request.auth.uid;
      allow create: if signedIn() &&
        hasProfessionalRole(request.auth.uid) &&
        request.resource.data.professionalAuthUid == request.auth.uid &&
        (request.resource.data.specialty == 'nutritionist' || request.resource.data.specialty == 'fitness_coach') &&
        specialtyId == request.auth.uid + '_' + request.resource.data.specialty;
      allow update: if signedIn() &&
        hasProfessionalRole(request.auth.uid) &&
        resource.data.professionalAuthUid == request.auth.uid &&
        resource.data.isActive == false &&
        request.resource.data.isActive == true &&
        request.resource.data.professionalAuthUid == request.auth.uid &&
        request.resource.data.specialty == resource.data.specialty &&
        specialtyId == request.auth.uid + '_' + resource.data.specialty;
      allow delete: if false;
    }

    match /credentials/{credentialId} {
      allow read, update, delete: if signedIn() && resource.data.professionalAuthUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.professionalAuthUid == request.auth.uid;
    }

    function nutritionIdentityUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.studentAuthUid == resource.data.studentAuthUid &&
        request.resource.data.ownerProfessionalUid == resource.data.ownerProfessionalUid &&
        request.resource.data.sourceKind == resource.data.sourceKind &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function canArchiveAssignedNutritionPlanOnConnectionEnd() {
      return resource.data.sourceKind == 'assigned' &&
        nutritionIdentityUnchanged() &&
        planLifecycleStateOnlyChanged() &&
        resource.data.isArchived == false &&
        request.resource.data.isArchived == true &&
        resource.data.ownerProfessionalUid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid &&
        (hasEndedNutritionistConnectionForPlan(resource.data.studentAuthUid) ||
          hasExistingEndedNutritionistConnectionForPlan(resource.data.studentAuthUid));
    }

    function canUpdateSelfManagedNutritionPlan() {
      return resource.data.studentAuthUid == request.auth.uid &&
        resource.data.ownerProfessionalUid == null &&
        resource.data.sourceKind == 'self_managed' &&
        resource.data.isArchived == false &&
        !hasActiveNutritionistSpecialtyForStudent(resource.data.studentAuthUid) &&
        planArchiveMetadataUnchanged() &&
        nutritionIdentityUnchanged();
    }

    function isPublishedNutritionPlanForStudentRead() {
      return resource.data.studentAuthUid == request.auth.uid &&
        resource.data.isDraft != true &&
        (
          resource.data.sourceKind != 'assigned' ||
          hasActiveNutritionistConnectionForStudentAndProfessional(resource.data.studentAuthUid, resource.data.ownerProfessionalUid)
        );
    }

    function canCreateSelfManagedNutritionPlan() {
      return request.resource.data.studentAuthUid == request.auth.uid &&
        request.resource.data.ownerProfessionalUid == null &&
        request.resource.data.sourceKind == 'self_managed' &&
        request.resource.data.isDraft == false &&
        request.resource.data.isArchived == false &&
        !hasActiveNutritionistSpecialtyForStudent(request.auth.uid);
    }

    function canCreateProfessionalLibraryNutritionPlan() {
      return request.resource.data.studentAuthUid == request.auth.uid &&
        request.resource.data.ownerProfessionalUid == request.auth.uid &&
        request.resource.data.sourceKind == 'predefined' &&
        hasActiveProfessionalSpecialty(request.auth.uid, 'nutritionist') &&
        (request.resource.data.isDraft == false ||
          request.resource.data.isDraft == true) &&
        request.resource.data.isArchived == false;
    }

    function canCreateAssignedNutritionPlan() {
      return request.resource.data.ownerProfessionalUid == request.auth.uid &&
        request.resource.data.studentAuthUid != request.auth.uid &&
        request.resource.data.sourceKind == 'assigned' &&
        (request.resource.data.isDraft == false || request.resource.data.isDraft == true) &&
        request.resource.data.isArchived == false &&
        hasActiveNutritionistTrackingAccess(request.resource.data.studentAuthUid);
    }

    function canUpdateProfessionalLibraryNutritionPlan() {
      return resource.data.ownerProfessionalUid == request.auth.uid &&
        resource.data.studentAuthUid == request.auth.uid &&
        resource.data.sourceKind == 'predefined' &&
        hasActiveProfessionalSpecialty(request.auth.uid, 'nutritionist') &&
        nutritionIdentityUnchanged() &&
        planArchiveMetadataUnchanged();
    }

    function canUpdateAssignedNutritionPlan() {
      return resource.data.ownerProfessionalUid == request.auth.uid &&
        resource.data.sourceKind == 'assigned' &&
        (request.resource.data.isDraft == false || request.resource.data.isDraft == true) &&
        nutritionIdentityUnchanged() &&
        planArchiveMetadataUnchanged() &&
        hasActiveNutritionistTrackingAccess(resource.data.studentAuthUid);
    }

    function canArchiveSelfManagedNutritionPlanOnConnectionActivation() {
      return resource.data.sourceKind == 'self_managed' &&
        resource.data.ownerProfessionalUid == null &&
        nutritionIdentityUnchanged() &&
        planLifecycleStateOnlyChanged() &&
        resource.data.isArchived == false &&
        request.resource.data.isArchived == true &&
        hasActivatedNutritionistConnectionForPlan(resource.data.studentAuthUid);
    }

    function canRestoreSelfManagedNutritionPlanOnConnectionEnd() {
      return resource.data.sourceKind == 'self_managed' &&
        resource.data.ownerProfessionalUid == null &&
        nutritionIdentityUnchanged() &&
        planLifecycleStateOnlyChanged() &&
        resource.data.isArchived == true &&
        request.resource.data.isArchived == false &&
        resource.data.get('lifecycleConnectionId', null) == request.resource.data.lifecycleConnectionId &&
        (hasEndedNutritionistConnectionForPlan(resource.data.studentAuthUid) ||
          hasExistingEndedNutritionistConnectionForPlan(resource.data.studentAuthUid));
    }

    function canDeleteSelfManagedNutritionPlan() {
      return resource.data.studentAuthUid == request.auth.uid &&
        resource.data.ownerProfessionalUid == null &&
        resource.data.sourceKind == 'self_managed';
    }

    function canDeleteProfessionalLibraryNutritionPlan() {
      return resource.data.ownerProfessionalUid == request.auth.uid &&
        resource.data.studentAuthUid == request.auth.uid &&
        resource.data.sourceKind == 'predefined' &&
        hasActiveProfessionalSpecialty(request.auth.uid, 'nutritionist');
    }

    function canDeleteAssignedNutritionPlan() {
      return resource.data.ownerProfessionalUid == request.auth.uid &&
        resource.data.sourceKind == 'assigned' &&
        hasActiveNutritionistTrackingAccess(resource.data.studentAuthUid);
    }

    match /nutritionPlans/{planId} {
      allow read: if signedIn() && (
        resource.data.ownerProfessionalUid == request.auth.uid ||
        isPublishedNutritionPlanForStudentRead()
      );
      allow create: if signedIn() && (
        canCreateSelfManagedNutritionPlan() ||
        canCreateProfessionalLibraryNutritionPlan() ||
        canCreateAssignedNutritionPlan()
      );
      allow update: if signedIn() && (
        canUpdateSelfManagedNutritionPlan() ||
        canUpdateProfessionalLibraryNutritionPlan() ||
        canArchiveSelfManagedNutritionPlanOnConnectionActivation() ||
        canArchiveAssignedNutritionPlanOnConnectionEnd() ||
        canRestoreSelfManagedNutritionPlanOnConnectionEnd() ||
        canUpdateAssignedNutritionPlan()
      );
      allow delete: if signedIn() && (
        canDeleteSelfManagedNutritionPlan() ||
        canDeleteProfessionalLibraryNutritionPlan() ||
        canDeleteAssignedNutritionPlan()
      );
    }

    function trainingIdentityUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.studentAuthUid == resource.data.studentAuthUid &&
        request.resource.data.ownerProfessionalUid == resource.data.ownerProfessionalUid &&
        request.resource.data.sourceKind == resource.data.sourceKind &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function isPublishedForStudentRead() {
      return resource.data.studentAuthUid == request.auth.uid &&
        resource.data.isDraft != true &&
        (
          resource.data.sourceKind != 'assigned' ||
          hasActiveFitnessCoachConnectionForStudentAndProfessional(resource.data.studentAuthUid, resource.data.ownerProfessionalUid)
        );
    }

    function canCreateSelfManagedTrainingPlan() {
      return request.resource.data.studentAuthUid == request.auth.uid &&
        request.resource.data.ownerProfessionalUid == null &&
        request.resource.data.sourceKind == 'self_managed' &&
        request.resource.data.isDraft == false &&
        request.resource.data.isArchived == false &&
        !hasActiveFitnessCoachSpecialtyForStudent(request.auth.uid);
    }

    function canCreateProfessionalLibraryTrainingPlan() {
      return request.resource.data.studentAuthUid == request.auth.uid &&
        request.resource.data.ownerProfessionalUid == request.auth.uid &&
        request.resource.data.sourceKind == 'predefined' &&
        hasActiveProfessionalSpecialty(request.auth.uid, 'fitness_coach') &&
        (request.resource.data.isDraft == false ||
          request.resource.data.isDraft == true) &&
        request.resource.data.isArchived == false;
    }

    function canCreateAssignedTrainingPlan() {
      return request.resource.data.ownerProfessionalUid == request.auth.uid &&
        request.resource.data.studentAuthUid != request.auth.uid &&
        request.resource.data.sourceKind == 'assigned' &&
        request.resource.data.isArchived == false &&
        hasActiveFitnessCoachTrackingAccess(request.resource.data.studentAuthUid);
    }

    function canUpdateSelfManagedTrainingPlan() {
      return resource.data.studentAuthUid == request.auth.uid &&
        resource.data.ownerProfessionalUid == null &&
        resource.data.sourceKind == 'self_managed' &&
        resource.data.isArchived == false &&
        !hasActiveFitnessCoachSpecialtyForStudent(resource.data.studentAuthUid) &&
        planArchiveMetadataUnchanged() &&
        trainingIdentityUnchanged();
    }

    function canUpdateProfessionalLibraryTrainingPlan() {
      return resource.data.ownerProfessionalUid == request.auth.uid &&
        resource.data.studentAuthUid == request.auth.uid &&
        resource.data.sourceKind == 'predefined' &&
        hasActiveProfessionalSpecialty(request.auth.uid, 'fitness_coach') &&
        planArchiveMetadataUnchanged() &&
        trainingIdentityUnchanged();
    }

    function canUpdateAssignedTrainingPlan() {
      return resource.data.ownerProfessionalUid == request.auth.uid &&
        resource.data.sourceKind == 'assigned' &&
        planArchiveMetadataUnchanged() &&
        trainingIdentityUnchanged() &&
        hasActiveFitnessCoachTrackingAccess(resource.data.studentAuthUid);
    }

    function canArchiveAssignedTrainingPlanOnConnectionEnd() {
      return resource.data.sourceKind == 'assigned' &&
        trainingIdentityUnchanged() &&
        planLifecycleStateOnlyChanged() &&
        resource.data.isArchived == false &&
        request.resource.data.isArchived == true &&
        resource.data.ownerProfessionalUid == get(/databases/$(database)/documents/connections/$(request.resource.data.lifecycleConnectionId)).data.professionalAuthUid &&
        (hasEndedFitnessCoachConnectionForPlan(resource.data.studentAuthUid) ||
          hasExistingEndedFitnessCoachConnectionForPlan(resource.data.studentAuthUid));
    }

    function canArchiveSelfManagedTrainingPlanOnConnectionActivation() {
      return resource.data.sourceKind == 'self_managed' &&
        resource.data.ownerProfessionalUid == null &&
        trainingIdentityUnchanged() &&
        planLifecycleStateOnlyChanged() &&
        resource.data.isArchived == false &&
        request.resource.data.isArchived == true &&
        hasActivatedFitnessCoachConnectionForPlan(resource.data.studentAuthUid);
    }

    function canRestoreSelfManagedTrainingPlanOnConnectionEnd() {
      return resource.data.sourceKind == 'self_managed' &&
        resource.data.ownerProfessionalUid == null &&
        trainingIdentityUnchanged() &&
        planLifecycleStateOnlyChanged() &&
        resource.data.isArchived == true &&
        request.resource.data.isArchived == false &&
        resource.data.get('lifecycleConnectionId', null) == request.resource.data.lifecycleConnectionId &&
        (hasEndedFitnessCoachConnectionForPlan(resource.data.studentAuthUid) ||
          hasExistingEndedFitnessCoachConnectionForPlan(resource.data.studentAuthUid));
    }

    function canDeleteSelfManagedTrainingPlan() {
      return resource.data.studentAuthUid == request.auth.uid &&
        resource.data.ownerProfessionalUid == null &&
        resource.data.sourceKind == 'self_managed';
    }

    function canDeleteProfessionalLibraryTrainingPlan() {
      return resource.data.ownerProfessionalUid == request.auth.uid &&
        resource.data.studentAuthUid == request.auth.uid &&
        resource.data.sourceKind == 'predefined' &&
        hasActiveProfessionalSpecialty(request.auth.uid, 'fitness_coach');
    }

    function canDeleteAssignedTrainingPlan() {
      return resource.data.ownerProfessionalUid == request.auth.uid &&
        resource.data.sourceKind == 'assigned' &&
        hasActiveFitnessCoachTrackingAccess(resource.data.studentAuthUid);
    }

    match /trainingPlans/{planId} {
      allow read: if signedIn() && (
        resource.data.ownerProfessionalUid == request.auth.uid ||
        isPublishedForStudentRead()
      );
      allow create: if signedIn() && (
        canCreateSelfManagedTrainingPlan() ||
        canCreateProfessionalLibraryTrainingPlan() ||
        canCreateAssignedTrainingPlan()
      );
      allow update: if signedIn() && (
        canUpdateSelfManagedTrainingPlan() ||
        canUpdateProfessionalLibraryTrainingPlan() ||
        canArchiveSelfManagedTrainingPlanOnConnectionActivation() ||
        canArchiveAssignedTrainingPlanOnConnectionEnd() ||
        canRestoreSelfManagedTrainingPlanOnConnectionEnd() ||
        canUpdateAssignedTrainingPlan()
      );
      allow delete: if signedIn() && (
        canDeleteSelfManagedTrainingPlan() ||
        canDeleteProfessionalLibraryTrainingPlan() ||
        canDeleteAssignedTrainingPlan()
      );
    }

    match /planChangeRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.studentAuthUid == request.auth.uid ||
        ownsPlan(resource.data.planId)
      );
      allow create: if signedIn() && request.resource.data.studentAuthUid == request.auth.uid;
      allow update, delete: if signedIn() && (
        resource.data.studentAuthUid == request.auth.uid ||
        ownsPlan(resource.data.planId)
      );
    }

    match /trackingAccess/{studentUid}/nutritionists/{professionalUid} {
      allow read: if signedIn() && (request.auth.uid == studentUid || request.auth.uid == professionalUid);
      allow create, update: if validTrackingAccessWrite(studentUid, professionalUid, 'nutritionist');
      allow delete: if false;
    }

    match /trackingAccess/{studentUid}/fitnessCoaches/{professionalUid} {
      allow read: if signedIn() && (request.auth.uid == studentUid || request.auth.uid == professionalUid);
      allow create, update: if validTrackingAccessWrite(studentUid, professionalUid, 'fitness_coach');
      allow delete: if false;
    }

    match /trackingAccess/{studentUid}/activeSpecialties/{specialtyId} {
      allow read: if signedIn() && (request.auth.uid == studentUid || request.auth.uid == resource.data.professionalAuthUid);
      allow create: if validActiveSpecialtyCreate(studentUid, specialtyId);
      allow update: if validActiveSpecialtyUpdate(studentUid, specialtyId);
      allow delete: if false;
    }

    match /waterLogs/{logId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        hasActiveNutritionistTrackingAccess(resource.data.ownerUid)
      );
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /waterGoals/{goalId} {
      allow read: if signedIn() && (
        goalId == request.auth.uid ||
        hasActiveNutritionistTrackingAccess(goalId)
      );
      allow create: if signedIn() && goalId == request.auth.uid && request.resource.data.ownerUid == goalId;
      allow update, delete: if signedIn() && goalId == request.auth.uid;
    }

    match /customMeals/{mealId} {
      allow read, update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /mealShareLinks/{shareToken} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /portionLogs/{logId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        hasActiveNutritionistTrackingAccess(resource.data.ownerUid)
      );
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /workoutLogs/{logId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        hasActiveFitnessCoachTrackingAccess(resource.data.ownerUid)
      );
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /starterTemplates/{templateId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /supportMessages/{messageId} {
      allow create: if isUid(request.resource.data.userId);
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
